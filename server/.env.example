PORT=5000
NODE_ENV=development
JWT_SECRET=namasty_sky_blue_secret_key_2026_super_secure
JWT_REFRESH_SECRET=namasty_sky_blue_refresh_token_secret_2026

# Database configuration (MongoDB / MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/namasty_messenger
# MongoDB Atlas Example:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.namasty.mongodb.net/namasty_messenger?retryWrites=true&w=majority

USE_IN_MEMORY_FALLBACK=true

# Redis configuration (Used for presence, typing, OTP cache & Socket.IO pub/sub)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Client CORS
CLIENT_ORIGIN=*
